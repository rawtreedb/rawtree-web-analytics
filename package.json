{
  "name": "rawtree-web-analytics",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build -w @rawtree/analytics && next dev",
    "build": "npm run build -w @rawtree/analytics && next build",
    "start": "next start",
    "test": "npm run build -w @rawtree/analytics && npm test -w @rawtree/analytics && node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "sdk:pack": "mkdir -p examples/test-console/vendor && npm pack -w @rawtree/analytics --pack-destination examples/test-console/vendor",
    "console:install": "npm run sdk:pack && cd examples/test-console && npm install ./vendor/rawtree-analytics-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "rrweb": "2.1.7",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
