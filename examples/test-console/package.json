{
  "name": "rawtree-test-console",
  "version": "0.0.0",
  "private": true,
  "description": "Test console for the packed @rawtree/analytics SDK, styled like the RawTree dashboard",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
