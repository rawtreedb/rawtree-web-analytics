# Copy to .env.local and fill in. Never commit real keys.

# RawTree API base URL. Optional: defaults to https://api.rawtree.com.
RAWTREE_API_URL=https://api.rawtree.com

# Database that holds the `events` and `recordings` tables.
RAWTREE_DATABASE=web_analytics

# Insert-only key for event and recording ingestion (rtree key create --permission write_only).
# Tables are created on first insert. A key bound to database_roles with only
# `GRANT INSERT ON <database>.*` is tighter, but then create the tables first.
RAWTREE_INGEST_KEY=rt_...

# Read-only key for the dashboard and replay (rtree key create --permission read_only),
# or a key bound to database_roles with only `GRANT SELECT ON <database>.*`.
RAWTREE_QUERY_KEY=rt_...

# Mode: with RAWTREE_QUERY_KEY and RAWTREE_INGEST_KEY set, the dashboard needs no sign-in
# (env mode). Leave both empty for sign-in mode: visitors use their own RawTree API key or,
# when RAWTREE_CONNECTOR is set, Connect with RawTree through Vercel Connect.
# Optional, sign-in mode only. Vercel Connect connector UID, e.g. rawtree/web-analytics
# (vercel connect create rawtree --target api --name web-analytics; run `vercel env pull` locally).
RAWTREE_CONNECTOR=

# Collector (app/api/collect)
# Comma-separated origins (scheme://host[:port]) of the sites that send events to /api/collect,
# or "*" to accept any origin. Origin checks reject unwanted browsers; they are not authentication.
# The dashboard's own Console doesn't need an entry here.
ANALYTICS_ALLOWED_ORIGINS=https://example.com

# Optional. Shared secret for trusted backend events (createServerAnalytics({ token })).
# Requests with `Authorization: Bearer <token>` are stored with source "server".
# Leave empty to disable server events. Generate with: openssl rand -hex 32
ANALYTICS_SERVER_TOKEN=

# Optional. Prefix for table names, used for disposable test tables (e.g. e2e_). Empty in production.
RAWTREE_TABLE_PREFIX=
